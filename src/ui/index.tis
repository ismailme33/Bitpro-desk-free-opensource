        html += "<div tabindex='0' .custom-event mm-id='" + m + "' style='padding: 6px 10px; cursor:pointer;" + selected + "'>" + multiMonitorLabel(m) + "</div>";
    }
    html += "</div>";
    msgbox("custom-nocancel-nook-dismissible", translate("Multiple Monitors"), html, "", function(el) {
        if (el && el.attributes && el.attributes["mm-id"] !== undefined) {
            handler.set_option("multi-monitor-layout", el.attributes["mm-id"]);
            closeMsgbox();
            app.update();
        }
    }, 300);
}

function macPermissions() {
    try { return JSON.parse(handler.get_mac_permissions()); } catch (e) { return {}; }
}

function macRequiredMissing(p) {
    return (p.screen ? 0 : 1) + (p.accessibility ? 0 : 1);
}

function macPermissionRow(id, name, why, allowed, buttonLabel) {
    var html = "<div style='flow: horizontal; vertical-align: middle; padding: 6px 16px;'><div style='width: *;'><div>" + translate(name) + "</div>";
    if (!allowed) {
        html += "<div style='font-size: 0.8em; color: color(light-text);'>" + translate(why) + "</div>";
    }
    html += "</div>";
    if (allowed) {
        html += "<div style='color: #28A745; font-size: 0.9em; margin-left: 8px;'>&#10003; " + translate("Allowed") + "</div>";
    } else {
        var outline = buttonLabel == "Open System Setting" ? " .outline" : "";
        html += "<button .button" + outline + " .custom-event perm-id='" + id + "' style='margin-left: 8px;'>" + translate(buttonLabel) + "</button>";
    }
    return html + "</div>";
}

var macPermissionsShown = "";

function showMacPermissions() {
    var p = macPermissions();
    var micAllowed = p.microphone == "allowed";
    var micDenied = p.microphone == "denied";
    var html = "<div #mac-permissions style='max-height: 420px; overflow-y: scroll-indicator;'>";
    html += "<div style='padding: 0 16px 4px; color: color(light-text);'>" + translate("Allow these once, while you are at this Mac, so HopToDesk works when no one is here.") + "</div>";
    html += "<div .section-label>" + translate("Required") + "</div>";
    html += macPermissionRow("screen", "Screen Recording", "The other person can see this screen.", p.screen, "Allow");
    html += macPermissionRow("accessibility", "Accessibility", "The other person can use the mouse and keyboard.", p.accessibility, "Allow");
    html += "<div .section-label>" + translate("Recommended") + "</div>";
    html += macPermissionRow("disk", "Full Disk Access", "File transfer opens Desktop, Documents, Downloads and USB drives with no macOS questions.", p.disk, "Open System Setting");
    html += macPermissionRow("input", "Input Monitoring", "Lets this Mac send its keyboard when it controls another computer.", p.input, "Allow");
    html += "<div .section-label>" + translate("Optional") + "</div>";
    html += macPermissionRow("microphone", "Microphone", "For voice calls and headsets.", micAllowed, micDenied ? "Open System Setting" : "Allow");
    if (!macRequiredMissing(p)) {
        html += "<div style='padding: 10px 16px 0; color: #28A745;'>" + translate("This Mac is ready for unattended access") + "</div>";
    }
    html += "</div>";
    macPermissionsShown = JSON.stringify(p);
    msgbox("custom-nocancel-dismissible", translate("Mac permissions"), html, "", function(el) {
        if (el && el.attributes && el.attributes["perm-id"]) {
            handler.request_mac_permission(el.attributes["perm-id"]);
            return true;
        }
    }, 470, 480);
    self.timer(1s, refreshMacPermissions);
}

function refreshMacPermissions() {
    if (!$(#mac-permissions)) return;
    if (JSON.stringify(macPermissions()) != macPermissionsShown) {
        showMacPermissions();
        app.update();
        return;
    }
    self.timer(1s, refreshMacPermissions);
}

