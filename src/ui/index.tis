var MULTI_MONITOR_MODES = ["", "all", "separate"];

function multiMonitorLabel(mode) {
    var v = (mode === undefined) ? handler.get_option("multi-monitor-layout") : mode;
    if (v == "all") return translate("All Displays");
    if (v == "separate") return translate("Each monitor in its own window");
    return translate("Current Display");
}

