            <div>{system_error}</div>
        </div>;
    }
}

class TrustMe: Reactor.Component {
    function render() {
        return <div .trust-me #trust-me-box style="margin-top: -4px;">
            <div style="margin-top: 10px;">{translate('Permissions')}</div>
            <div style="text-align: center">{translate('config_acc')}</div>
            <div #trust-me .link tabindex="0">{translate('Configure')}</div>
        </div>;
    }

    event click $(#trust-me) {
        handler.is_process_trusted(true);
        watch_trust();
    }
}

class CanScreenRecording: Reactor.Component {
    function render() {
        return <div .trust-me #screen-recording-box style="margin-top: -4px;">
            <div>{translate('Permissions')}</div>
            <div>{translate('config_screen')}</div>
            <div #screen-recording .link tabindex="0">{translate('Configure')}</div>
            <div #help-me style="display:none" .link tabindex="0">{translate('Help')}</div>
        </div>;
    }

    event click $(#screen-recording) {
        handler.is_can_screen_recording(true);
        watch_screen_recording();
    }

    event click $(#help-me) {
        handler.open_url(translate("doc_mac_permission"));
    }
}

class InstallDaemon: Reactor.Component {
    function render() {
        return <div .install-me>
            <span />
            <div>{translate('install_daemon_tip')}</div>
            <div #install-me.link tabindex="0">{translate('Install')}</div>
        </div>;
    }

    event click $(#install-me) {
        handler.is_installed_daemon(true);
    }
}

function watch_trust() {
    // not use TrustMe::update, because it is buggy
    var trusted = handler.is_process_trusted(false);
    var el = $(div#trust-me-box);
    if (el) {
        el.style.set {
            display: trusted ? "none" : "block",
        };
    }
    if (trusted) {
        app.update();
        return;
    }
    self.timer(1s, watch_trust);
}

function watch_screen_recording() {
    var trusted = handler.is_can_screen_recording(false);
    var el = $(div#screen-recording-box);
    if (el) {
        el.style.set {
            display: trusted ? "none" : "block",
        };
    }
    if (trusted) {
        app.update();
        return;
    }
    self.timer(1s, watch_screen_recording);
}

class PasswordEyeArea : Reactor.Component {
    render() {
        if (!key_confirmed) {
            return <div #passwordbox .passwordbox readonly>...</div>;
        }
        if (handler.get_option('account-access-only') == 'Y' && handler.get_option('dashboard_user_id') != '') {
            return <div #passwordbox .passwordbox readonly title={translate('Easy Access')}>&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;</div>;
        }
        if (handler.get_option('hide-password') == 'Y') {
            return <div #passwordbox .passwordbox readonly>&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;</div>;
        }
        if (handler.get_option('verification-method') == 'use-permanent-password') {
            return <div #passwordbox .passwordbox readonly title={translate('Use permanent password')}>&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;</div>;
        }
        var value = password_cache[0] || handler.temporary_password() || "";
        return
            <div #passwordbox .passwordbox tabindex="0" readonly title={translate('Password (Click to Copy)')}>{value}</div>;
    }

    event click $(#passwordbox) (_, me) {
        if (handler.get_option('verification-method') == 'use-permanent-password' || handler.get_option('hide-password') == 'Y') return;
        var pw = password_cache[0] || "";
        if (pw && pw != "-") { handler.copy_text(pw); }
    }
}

var temporaryPasswordLengthMenu;
class TemporaryPasswordLengthMenu: Reactor.Component {
    function this() {
        temporaryPasswordLengthMenu = this;
    }

    function render() {
        if (!this.show) return <li />;
        var me = this;
        var method = handler.get_option('verification-method');
        self.timer(1ms, function() { me.toggleMenuState() });
        return <li disabled={ method == 'use-permanent-password' ? "true" : "false" }>{translate("One-time password length")}
            <menu #temporary-password-length>
                <li #temporary-password-length-6><span>{svg_checkmark}</span>6</li>
                <li #temporary-password-length-8><span>{svg_checkmark}</span>8</li>
                <li #temporary-password-length-10><span>{svg_checkmark}</span>10</li>
            </menu>
        </li>;
    }

    function toggleMenuState() {
        var length = handler.get_option("temporary-password-length");
        var index = ['6', '8', '10'].indexOf(length);
        if (index < 0) index = 0;
        for (var (i, el) in this.$$(menu#temporary-password-length>li)) {
            el.attributes.toggleClass("selected", i == index);
        }
    }

    event click $(menu#temporary-password-length>li) (_, me) {
        var length = me.id.substring('temporary-password-length-'.length);
        var old_length = handler.get_option('temporary-password-length');
        if (length != old_length) {
            handler.set_option('temporary-password-length', length);
            handler.update_temporary_password();
            this.toggleMenuState();
            passwordArea.update();
        }
    }
}

var passwordArea;
class PasswordArea: Reactor.Component {
    function this() {
        passwordArea = this;
    }

    function render() {
        var isunattended = handler.get_option("unattended-access");
        var unattendedStyle = handler.is_option_fixed("unattended-access") ? "opacity:0.5;" : "";
		var is_sso = handler.get_option("sso-login");
		if (is_sso) {
			return
			<div .password-area>
				<div .pw-label>{translate('Password')}</div>
				<div .sso-badge>SSO Mode</div>
			</div>;
		}
		if (isunattended) {
			return
			<div .password-area>
				<div .pw-label>{translate('Password')}</div>
				<div .pw-value-row>
					<PasswordEyeArea />
					{key_confirmed ? <div #edit-pill .pw-pill tabindex="0" title={translate('Password settings')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>{translate('Set')}</div> : ""}
					<div style="width:*;" />
					<div .pw-toggle-inline style={unattendedStyle}>
						<span id="unattendedlabel">{translate('Unattended Access')}</span>
						<label .toggle-switch tabindex="0" title={translate('Set a permanent password to allow access to this device at any time, even when no one is present.')}>
						    <input type="checkbox" id="unattendedcheckbox" name="unattendedcheckbox" checked />
						    <span .toggle-slider />
						</label>
					</div>
				</div>
			</div>;
		} else {
			return
			<div .password-area>
				<div .pw-label>{translate('Password')}</div>
				<div .pw-value-row>
					<PasswordEyeArea />
					{key_confirmed ? <div #edit-pill .pw-pill tabindex="0" title={translate('Password settings')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>{translate('Set')}</div> : ""}
					<div style="width:*;" />
					<div .pw-toggle-inline style={unattendedStyle}>
						<span id="unattendedlabel">{translate('Unattended Access')}</span>
						<label .toggle-switch tabindex="0" title={translate('Set a permanent password to allow access to this device at any time, even when no one is present.')}>
						    <input type="checkbox" id="unattendedcheckbox" name="unattendedcheckbox" />
						    <span .toggle-slider />
						</label>
					</div>
				</div>
			</div>;
		}
    }

    event click $(#edit-pill) {
        passwordSettingsOpen = true;
        app.update();
    }

    event click $(#unattendedcheckbox) (_, me) {
		if (handler.is_option_fixed("unattended-access")) {
			me.state.checked = handler.get_option("unattended-access") == "true";
			return;
		}
		if (me.state.checked) {
			handler.set_option("unattended-access", "true");
			$(#unattendedlabel).style.set{color: "#333"};
		} else {
			handler.set_option("unattended-access", "");
			$(#unattendedlabel).style.set{color: "#94A3B8"};
		}
    }
}

var password_cache = ["","","",""];
function updatePasswordArea() {
    self.timer(1s, function() {
        var temporary_password = handler.temporary_password();
        var verification_method = handler.get_option('verification-method');
        var temporary_password_length = handler.get_option('temporary-password-length');
        var approve_mode = handler.get_option('approve-mode');
        var update = false;
        if (password_cache[0] != temporary_password) {
            password_cache[0] = temporary_password;
            update = true;
        }
        if (password_cache[1] != verification_method) {
            password_cache[1] = verification_method;
            update = true;
        }
        if (password_cache[2] != temporary_password_length) {
            password_cache[2] = temporary_password_length;
            update = true;
        }
        if (password_cache[3] != approve_mode) {
            password_cache[3] = approve_mode;
            update = true;
        }
        if (update) passwordArea.update();
        updatePasswordArea();
    });
}
updatePasswordArea();

class ID: Reactor.Component {
    function render() {
        return <input type="text" #remote_id .outline-focus title={translate('Enter Remote ID')} novalue={translate("Enter Remote ID")} maxlength="21"
        value={formatId(handler.get_remote_id())} />;
    }

    event change {
        var fid = formatId(this.value);
        var d = this.value.length - (this.old_value || "").length;
        this.old_value = this.value;
        var start = this.xcall(#selectionStart) || 0;
        var end = this.xcall(#selectionEnd);
        if (fid == this.value || d <= 0 || start != end) {
            return;
        }
        // fix Caret position
        this.value = fid;
        var text_after_caret = this.old_value.substr(start);
        var n = fid.length - formatId(text_after_caret).length;
        this.xcall(#setSelection, n, n);
    }
}

var reg = /^\d+$/;
function formatId(id) {
    id = id.replace(/\s/g, "");
    if (reg.test(id) && id.length > 3) {
        var n = id.length;
        var a = n % 3 || 3;
        var new_id = id.substr(0, a);
        for (var i = a; i < n; i += 3) {
            new_id += " " + id.substr(i, 3);
        }
        return new_id;
    }
    return id;
}

event keydown (evt) {
    if (view.focus && view.focus.id != 'remote_id') {
        return;
    }
    if (!evt.shortcutKey) {
        if (isEnterKey(evt)) {
            var el = $(button#connect);
            view.focus = el;
            el.sendEvent("click");
            // simulate button click effect, windows does not have this issue
            el.attributes.toggleClass("active", true);
            self.timer(0.3s, function() {
                el.attributes.toggleClass("active", false);
            });
        }
    }
}

$(body).content(<div style="size:*"><App /><div #msgbox /></div>);

function self.closing() {
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    handler.closing(x, y, w, h);
    if (handler.is_close_protected()) {
        view.windowState = View.WINDOW_HIDDEN;
        return false;
    }
    return true;
}

function self.ready() {
    var r = handler.get_size();
	var isquicksupport = handler.get_option('quicksupport') || handler.running_qs() || handler.is_incoming_only();	
    if (isReasonableSize(r) && r[2] > 0) {
        var (sx, sy, sw, sh) = view.screenBox(#workarea, #rectw);
		if (r[2] >= sw && r[3] >= sh) {
			if (!isquicksupport) {
				self.timer(1ms, function() { view.windowState = View.WINDOW_MAXIMIZED; });
			}
        } else {
            view.move(r[0], r[1], r[2], r[3]);
        }
    } else {
		centerize(scaleIt(800), scaleIt(655));
    }

	if (isquicksupport) {
		var pixelsPerInch = self.toPixels(1in);
		if (pixelsPerInch >= 120) {
			var el = $(#right-pane);
			el.style.set{display: "none"};
			centerize(scaleIt(230), scaleIt(430));
		} else {
			centerize(scaleIt(270), scaleIt(410));
		}
		
		view.windowResizable = false;
		view.windowMaximizable = false;
	}
	
    view.focus = $(#remote_id);
	//refreshCurrentUser();
    updateTheme();
    if (is_osx && handler.get_local_option("mac-permissions-shown") != "Y" && macRequiredMissing(macPermissions())) {
        handler.set_local_option("mac-permissions-shown", "Y");
        self.timer(500ms, showMacPermissions);
    }
    if (!dashboard_linked) {
        self.timer(10s, function() {
            if (handler.get_option("dashboard_user_id") != "") {
                dashboard_linked = true;
                app.update();
            }
        });
    }
}

function showGen2FA() {
    myIdMenu.showGen2FA();
}

function showAbout() {
    myIdMenu.showAbout();
}

function showSettings() {
    showSettingsPanel();
}

function showSettingsPanel() {
    settingsPanelOpen = !settingsPanelOpen;
    app.update();
    if (settingsPanelOpen) {
        var close = $(#settings-panel .settings-close);
        if (close) close.state.focus = true;
    }
}

function closeSettingsPanel() {
    settingsPanelOpen = false;
    app.update();
}

function confirmUnattendedWayland() {
    msgbox("custom-nocancel-nook-hasyes-hasno", translate("Unattended Wayland Access"),
        "<div .form><div>" + translate("drm_unattended_tip") + "</div></div>", "", function(el) {
            if (el && el.type === "custom-nocancel-nook-hasyes-hasno") {
                handler.set_option("enable-drm-capture", "Y");
                app.update();
            }
        }, 180);
}

function handleSettingsToggle(id) {
    var optionId = id.replace("toggle-", "");
    var protectedSettings = ["enable-keyboard", "enable-clipboard", "enable-file-transfer", "enable-remote-restart"];
    if (protectedSettings.indexOf(optionId) >= 0 && isRemoteControlled()) return;
    if (optionId == "stop-service") {
        handler.set_option("stop-service", service_stopped ? "" : "Y");
    } else if (optionId == "start-on-boot") {
        handler.set_start_on_boot(!handler.is_start_on_boot());
    } else if (optionId == "allow-darktheme") {
        handler.set_option("allow-darktheme", handler.get_option("allow-darktheme") == "Y" ? "" : "Y");
        updateTheme();
    } else if (optionId == "enable-wol") {
        var wasEnabled = handler.get_option("enable-wol") == "Y";
        handler.set_option("enable-wol", wasEnabled ? "N" : "Y");
        handler.set_option("wol-enabled", wasEnabled ? "" : "true");
        if (!wasEnabled) {
            closeSettingsPanel();
            self.timer(100ms, showWolInstructions);
        }
    } else if (optionId == "enable-remote-printing") {
        handler.set_option("enable-remote-printing", handler.get_option("enable-remote-printing") == "Y" ? "N" : "Y");
    } else if (optionId == "direct-server") {
        var wasEnabled = handler.get_option("direct-server") == "Y";
        handler.set_option("direct-server", wasEnabled ? "" : "Y");
        if (!wasEnabled) {
            closeSettingsPanel();
            self.timer(100ms, editDirectAccessPort);
        }
    } else if (optionId == "relay-443-only") {
        handler.set_option("relay-443-only", handler.get_option("relay-443-only") == "Y" ? "" : "Y");
    } else if (optionId == "enable-audio") {
        handler.set_option("enable-audio", handler.get_option("enable-audio") != "N" ? "N" : "");
    } else if (optionId == "enable-terminal") {
        handler.set_option("enable-terminal", handler.get_option("enable-terminal") == "Y" ? "" : "Y");
    } else if (optionId == "enable-easy-access") {
        closeSettingsPanel();
        self.timer(100ms, showDashboardLinkDialog);
        return;
    } else if (optionId == "enable-drm-capture") {
        if (handler.get_option("enable-drm-capture") == "Y") {
            handler.set_option("enable-drm-capture", "");
        } else {
            closeSettingsPanel();
            self.timer(100ms, confirmUnattendedWayland);
            return;
        }
    } else if (optionId == "allow-auto-record-outgoing") {
        handler.set_local_option(optionId, handler.get_local_option(optionId) == "Y" ? "" : "Y");
    } else if (optionId.indexOf("allow-") == 0) {
        handler.set_option(optionId, handler.get_option(optionId) == "Y" ? "" : "Y");
    } else if (optionId.indexOf("enable-") == 0) {
        handler.set_option(optionId, handler.get_option(optionId) == "N" ? "" : "N");
    }
    app.update();
}

function showWolInstructions() {
    msgbox("custom-nocancel-dismissible", translate("Wake On LAN"),
        <div .form>
            <div style="margin-bottom:10px;">{translate("Wake On LAN lets you power on this device remotely from another HopToDesk client or the dashboard.")}</div>
            <div style="margin-bottom:6px;font-weight:bold;">{translate("Requirements:")}</div>
            <div style="margin-bottom:4px;padding-left:8px;">{"\u2022\u00a0" + translate("This device must be connected via Ethernet (not WiFi).")}</div>
            <div style="margin-bottom:4px;padding-left:8px;">{"\u2022\u00a0" + translate("WoL must be enabled in the device's BIOS/UEFI settings.")}</div>
            <div style="margin-bottom:4px;padding-left:8px;">{"\u2022\u00a0" + translate("The network adapter must have WoL enabled in OS settings.")}</div>
            <div style="margin-bottom:10px;padding-left:8px;">{"\u2022\u00a0" + translate("Another HopToDesk device on the same network must be online to relay the wake signal.")}</div>
            <div style="color:#6C757D;font-size:0.9em;">{translate("The wake signal is sent by another online HopToDesk device on the same local network. You can trigger it from the address book in any HopToDesk client, or from the dashboard if enrolled.")}</div>
        </div>,
        "", function() {}, 280);
}

function handleSettingsAction(id) {
    var actionId = id.replace("action-", "");
    closeSettingsPanel();
    if (actionId == "custom-api-url") {
        myIdMenu.handleMenuClick({id: "custom-api-url"});
    } else if (actionId == "socks5-server") {
        myIdMenu.handleMenuClick({id: "socks5-server"});
    } else if (actionId == "tfa") {
        myIdMenu.showGen2FA();
    } else if (actionId == "guest-access") {
        showGuestAccessDialog();
    } else if (actionId == "about") {
        myIdMenu.showAbout();
    } else if (actionId == "language") {
        showLanguagePicker();
    } else if (actionId == "enable-lan-discovery") {
        handler.set_option("enable-lan-discovery", handler.get_option("enable-lan-discovery") == "N" ? "" : "N");
        showSettingsPanel();
    } else if (actionId == "open-recordings") {
        handler.open_recordings_directory();
    } else if (actionId == "recordings-folder") {
        var folder = view.selectFolder(translate("Recordings Folder"), handler.recordings_directory());
        if (folder) {
            handler.set_local_option("video-save-directory", folder);
            showSettingsPanel();
        }
    } else if (actionId == "check-updates") {
        var checked = handler.set_version_sync();
        if (handler.requires_update()) {
            myIdMenu.showUpdatePopup();
        } else if (!checked) {
            msgbox("custom-nocancel-dismissible", translate("Check for Updates"), translate("Could not check for updates. Please try again later."));
        } else {
            msgbox("custom-nocancel-dismissible", translate("Check for Updates"), translate("You are running the latest version."));
        }
    } else if (actionId == "multi-monitor") {
        showMultiMonitorPicker();
    } else if (actionId == "recording-retention") {
        showRecordingRetentionPicker();
        return;
    } else if (actionId == "audio-input") {
        showAudioInputPicker();
        return;
    } else if (actionId == "voice-call-microphone") {
        showVoiceCallMicrophonePicker();
        return;
    } else if (actionId == "mac-permissions") {
        showMacPermissions();
        return;
    } else if (actionId == "microphone-access") {
        if (handler.get_microphone_access() == "denied") {
            handler.open_url("x-apple.systempreferences:com.apple.preference.security?Privacy_Microphone");
        } else {
            handler.request_microphone_access();
        }
        return;
    } else if (actionId == "dashboard-link") {
        showDashboardLinkDialog();
    } else if (actionId == "identity-key") {
        showIdentityKeyDialog();
    } else if (actionId == "display-name") {
        showDisplayNameDialog();
    }
}

function validateIdentityKey(key) {
    if (key.length < 32 || key.length > 128) return false;
    for (var i = 0; i < key.length; i++) {
        var c = key.charAt(i);
        var isHex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
        if (!isHex) return false;
    }
    return true;
}

function showDisplayNameDialog() {
    var current = handler.get_local_option("display-name");
    msgbox("custom-display-name-dismissible", translate("Display Name"),
        "<div .form>" +
        "<div style='margin-bottom:0.5em;'>" + translate("The name shown to the remote device when you connect. Leave empty to use your computer login name.") + "</div>" +
        "<input|text(display_name) style='width:*; margin-top:0.5em;' spellcheck='false' maxlength='64' placeholder='" + translate("Display Name") + "' value='" + current.replace(/'/g, "&#39;") + "' />" +
        "</div>", "", function(res) {
            if (!res) return;
            if (typeof res.display_name !== 'undefined') {
                handler.set_local_option("display-name", (res.display_name || "").trim());
                showSettingsPanel();
            }
        }, 220);
}

function showIdentityKeyDialog() {
    var hasKey = handler.get_option("avatar-mint-secret") != "";
    msgbox("custom-identity-key-dismissible", translate("Identity Key"),
        "<div .form>" +
        "<div style='margin-bottom:0.5em;'>" + translate("Paste the identity key from your dashboard team page to show your verified photo when you connect.") + "</div>" +
        (hasKey ? "<div style='color:#28A745; font-size:0.85em; margin-bottom:0.5em;'>" + translate("An identity key is currently set. Leave empty and save to remove it.") + "</div>" : "") +
        "<input|text(identity_key) style='width:*; margin-top:0.5em;' spellcheck='false' maxlength='128' placeholder='" + translate("Identity Key") + "' />" +
        "</div>",
        null,
        function(res) {
            if (!res) return;
            if (res && typeof res.identity_key !== 'undefined') {
                var key = (res.identity_key || "").replace(/\s/g, "").toLowerCase();
                if (key.length == 0) {
                    handler.set_option("avatar-mint-secret", "");
                    showSettingsPanel();
                    return;
                }
                if (!validateIdentityKey(key)) {
                    msgbox("custom-error", translate("Error"), translate("Invalid identity key."));
                    return;
                }
                handler.set_option("avatar-mint-secret", key);
                showSettingsPanel();
            }
        }, 240, 500, false, "size: *; margin: 0;");
}

function showDashboardLinkDialog() {
    var isLinked = handler.get_option("dashboard_user_id") != "";
    if (isLinked) {
        var dashId = handler.get_option("dashboard_user_id");
        var unlinkLocked = handler.get_option("account-access-only") == "Y";
        msgbox("custom-nocancel-nook-hasclose-dismissible", translate("Dashboard"),
            "<div style='line-height: 1.8em'>" +
            "<div>" + translate("Status") + ": <b>" + translate("Linked") + "</b></div>" +
            "<div style='font-family:monospace; font-size:0.85em; color:#666; word-break:break-all; line-height:1.4em; margin-bottom:0.5em;'>" + dashId + "</div>" +
            (unlinkLocked ? "" :
            "<div tabindex='0' .unlink-pill .custom-event action='unlink'>" +
                "<svg viewBox='0 0 24 24'><path fill='currentColor' d='M17 7h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1 0 1.43-.97 2.63-2.29 2.99l1.46 1.46C20.88 15.61 22 13.95 22 12c0-2.76-2.24-5-5-5zm-1 4h-2.19l2 2H16zM2 4.27l3.11 3.11C3.29 8.12 2 9.91 2 12c0 2.76 2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1 0-1.59 1.21-2.9 2.76-3.07L8.73 11H8v2h2.73L13 15.27V17h1.73l4.01 4.01 1.41-1.41L3.41 2.86 2 4.27z'/></svg>" +
                translate("Unlink") +
            "</div>") +
            "</div>",
            null,
            function(me) {
                if (!unlinkLocked && me && me.attributes && me.attributes["action"] == "unlink") {
                    msgbox("custom-hasno-hasyes-nocancel-nook-dismissible", translate("Dashboard"),
                        translate("Are you sure you want to unlink this device from the dashboard?"),
                        null,
                        function(res) {
                            if (res) {
                                handler.set_option("dashboard_user_id", "");
                                handler.set_option("dashboard-device-key", "");
                                handler.set_option("invite_code", "");
                                msgbox("custom-nocancel-nook-hasclose-dismissible", translate("Dashboard"),
                                    translate("Device has been unlinked from the dashboard."),
                                    null, function() { showSettingsPanel(); });
                            }
                        });
                }
            }, 220, 500, false, "size: *; margin: 0;");
    } else {
        var linkError = handler.take_dashboard_link_error();
        msgbox("custom-dashboard-link-dismissible", translate("Dashboard"),
            "<div .form>" +
            (linkError ? "<div style='color:#D9534F; margin-bottom:0.5em;'>" + translate(linkError) + "</div>" : "") +
            "<div style='margin-bottom:0.5em;'>" + translate("Enter your invite code to link this device to a dashboard.") + "</div>" +
            "<div style='color:#888; font-size:0.85em; margin-bottom:0.5em;'>" + translate("You can find this code in your dashboard invite link.") + "</div>" +
            "<input|text(invite_code) .outline-focus style='width:*; margin-top:0.5em;' spellcheck='false' maxlength='16' placeholder='" + translate("16-character invite code") + "' />" +
            "</div>",
            null,
            function(res) {
                if (!res) return;
                if (res && typeof res.invite_code !== 'undefined') {
                    var code = (res.invite_code || "").replace(/\s/g, "");
                    if (code.length == 0) return;
                    if (!validateInviteCode(code)) {
                        msgbox("custom-error", translate("Error"), translate("Invalid invite code. Must be 16 characters (letters and numbers)."));
                        return;
                    }
                    var problem = handler.check_invite_code(code);
                    if (problem) {
                        msgbox("custom-error", translate("Error"), translate(problem));
                        return;
                    }
                    handler.set_option("invite_code", code);
                    msgbox("custom-success-noedit", translate("Dashboard"), translate("Linking to dashboard... This device will appear in the dashboard shortly."));
                }
            }, 240, 500, false, "size: *; margin: 0;");
    }
}

function validateInviteCode(code) {
    if (code.length != 16) return false;
    var hasUpper = false;
    for (var i = 0; i < code.length; i++) {
        var c = code.charAt(i);
        if (c >= 'A' && c <= 'Z') hasUpper = true;
        else if (c >= 'a' && c <= 'z') {}
        else if (c >= '0' && c <= '9') {}
        else return false;
    }
    return hasUpper;
}

function showLanguagePicker() {
    var langs = JSON.parse(handler.get_langs());
    var cur = handler.get_local_option("lang") || "default";
    var html = "<div .form style='max-height: 300px; overflow-y: scroll-indicator;'>";
    for (var lang in langs) {
        var selected = (lang[0] == cur) ? "font-weight:bold; color: #2C8CFF;" : "";
        var flag = LANG_FLAGS[lang[0]] || "";
        html += "<div tabindex='0' .custom-event lang-id='" + lang[0] + "' style='padding: 6px 10px; cursor:pointer;" + selected + "'>" + flag + "<span>" + lang[1] + "</span></div>";
    }
    html += "</div>";
    msgbox("custom-nocancel-nook-dismissible", translate("Language"), html, "", function(el) {
        if (el && el.attributes && el.attributes["lang-id"]) {
            var v = el.attributes["lang-id"];
            if (v == "default") v = "";
            handler.set_local_option("lang", v);
            closeMsgbox();
            app.update();
        }
    }, 300);
}

function showGuestAccessDialog() {
    var timeout = handler.get_option("guest-accept-timeout") || "180";
    var choices = [["30", translate("30 seconds")], ["60", translate("1 minute")], ["120", translate("{} minutes").replace("{}", "2")], ["180", translate("{} minutes").replace("{}", "3")], ["300", translate("{} minutes").replace("{}", "5")], ["600", translate("{} minutes").replace("{}", "10")]];
    var options = "";
    for (var c in choices) {
        options += "<option value='" + c[0] + "'" + (c[0] == timeout ? " selected" : "") + ">" + c[1] + "</option>";
    }
    var hasGuest = handler.guest_password() != "";
    var autoOption = handler.get_option("guest-auto-accept");
    var autoAccept = autoOption == "Y" || (autoOption == "" && hasGuest);
    var removeRow = hasGuest ? "<div style='margin-top: 8px;'><button|checkbox name='remove'>" + translate("Remove guest password") + "</button></div>" : "";
    msgbox("custom-guest-access", translate("Guest Access"), "<div .form> \
        <div style='margin-bottom: 10px; line-height: 1.5em;'>" + translate("A guest waits for someone at this device to accept or dismiss the connection.") + "</div> \
        <div>" + translate("Guest password") + (hasGuest ? " (" + translate("On") + ")" : "") + "</div> \
        <input|password name='password' .outline-focus style='width: *; margin-bottom: 8px;' /> \
        <div>" + translate("Confirm") + "</div> \
        <input|password name='confirm' style='width: *; margin-bottom: 8px;' /> \
        <div>" + translate("Time to answer") + "</div> \
        <select name='timeout' style='width: *;'>" + options + "</select> \
        <div style='margin-top: 8px;'><button|checkbox name='autoaccept'" + (autoAccept ? " checked" : "") + ">" + translate("Let the guest in if nobody answers in time") + "</button></div>" + removeRow + " \
        </div>", "", function(res=null) {
        if (!res) return;
        var p0 = (res.password || "").trim();
        var p1 = (res.confirm || "").trim();
        if (p0.length < 6 && p0.length != 0) return translate("Too short, at least 6 characters.");
        if (p0 != p1) return translate("The confirmation is not identical.");
        if (p0 && p0 == handler.permanent_password()) return translate("The guest password must differ from the permanent password.");
        handler.set_option("guest-accept-timeout", res.timeout || "180");
        handler.set_option("guest-auto-accept", res.autoaccept ? "Y" : "N");
        if (res.remove) handler.set_guest_password("");
        else if (p0) handler.set_guest_password(p0);
        app.update();
    }, 440);
}

