self << event keydown (evt) {
    if (evt.keyCode == Event.VK_ESCAPE) {
        if (passwordSettingsOpen) { passwordSettingsOpen = false; app.update(); return true; }
        if (settingsPanelOpen) { closeSettingsPanel(); return true; }
    }
    if (evt.keyCode == Event.VK_TAB && passwordSettingsOpen) {
        var modal = $(.pw-modal);
        if (modal) {
            var rows = modal.$$([tabindex]);
            if (rows.length > 0) {
                var cur = view.focus;
                var idx = -1;
                for (var i = 0; i < rows.length; i++) {
                    if (rows[i] === cur) { idx = i; break; }
                }
                if (evt.shiftKey) {
                    idx = idx <= 0 ? rows.length - 1 : idx - 1;
                } else {
                    idx = idx >= rows.length - 1 ? 0 : idx + 1;
                }
                rows[idx].state.focus = true;
            }
        }
        return true;
    }
    if (settingsPanelOpen && (evt.keyCode == Event.VK_TAB || evt.keyCode == Event.VK_UP || evt.keyCode == Event.VK_DOWN)) {
        var panel = $(#settings-panel);
        if (panel) {
            var rows = panel.$$([tabindex]);
            if (rows.length > 0) {
                var cur = view.focus;
                var idx = -1;
                for (var i = 0; i < rows.length; i++) {
                    if (rows[i] === cur) { idx = i; break; }
                }
                var goBack = (evt.keyCode == Event.VK_TAB && evt.shiftKey) || evt.keyCode == Event.VK_UP;
                if (goBack) {
                    idx = idx <= 0 ? rows.length - 1 : idx - 1;
                } else {
                    idx = idx >= rows.length - 1 ? 0 : idx + 1;
                }
                rows[idx].state.focus = true;
            }
        }
        return true;
    }
}

self << event click $(#settings-backdrop) {
    closeSettingsPanel();
}

self << event click $(#settings-panel .settings-close) {
    closeSettingsPanel();
}

self << event click $(#settings-panel .setting-row) (_, me) {
    var id = me.id;
    if (me.$is(.setting-locked)) return;
    if (id.indexOf("toggle-") == 0) {
        handleSettingsToggle(id);
    } else {
        handleSettingsAction(id);
    }
}

self << event keypress $(#settings-panel .setting-row) (evt, me) {
    if (isEnterKey(evt) || evt.keyCode == Event.VK_SPACE) {
        var id = me.id;
        if (me.$is(.setting-locked)) return;
        if (id.indexOf("toggle-") == 0) {
            handleSettingsToggle(id);
        } else {
            handleSettingsAction(id);
        }
    }
}

self << event keypress $(#settings-panel .settings-close) (evt) {
    if (isEnterKey(evt) || evt.keyCode == Event.VK_SPACE) {
        closeSettingsPanel();
    }
}

function showUpdatePopup() {
    myIdMenu.showUpdatePopup();
}

//hophere update
function updateCheck() {
	if (showingupdate === "1") {return;}
	if (handler.get_local_option("dontshowagain") === "1") {return;}
	
	if (handler.requires_update()) {
		showUpdatePopup();
	}
	
	var timeout = 43200s;

	self.timer(timeout, function() {
		handler.set_version_sync();
		stdout.println("Reloading API");
		if (handler.requires_update()) {
			showUpdatePopup();
		}
		updateCheck();
    });		
}
updateCheck();

function showDeviceNamePrompt() {
    var company = handler.get_option("device-name-company").replace(/'/g, "&#39;");
    var pcname = (handler.get_option("device-name-pc") || handler.get_hostname()).replace(/'/g, "&#39;");
    msgbox("custom", translate("Device Name"), "<div .form> \
        <div>" + translate("Enter a name for this device. Your support provider will see it in their dashboard.") + "</div> \
        <input|text .outline-focus name='company' maxlength='20' value='" + company + "' placeholder='" + translate("Company (optional)") + "' style=\"margin-top: 10px; max-width: 100%\" /> \
        <input|text name='pcname' maxlength='43' value='" + pcname + "' placeholder='" + translate("Device Name") + "' style=\"margin-top: 10px; max-width: 100%\" /> \
        </div>", "", function(res=null) {
        handler.set_option("device-name-prompt-done", "Y");
        if (!res) return;
        var company = (res.company || "").trim();
        var pcname = (res.pcname || "").trim();
        if (!pcname) pcname = handler.get_hostname();
        handler.set_option("device-name-company", company);
        handler.set_option("device-name-pc", pcname);
        handler.set_option("pending-device-name", company ? company + "-" + pcname : pcname);
    }, 320);
}

function deviceNamePromptCheck() {
    if (!handler.is_prompt_device_name()) return;
    if (handler.get_option("device-name-prompt-done") === "Y") return;
    self.timer(1500ms, function() {
        if (handler.get_option("device-name-prompt-done") === "Y") return;
        showDeviceNamePrompt();
    });
}
deviceNamePromptCheck();

function checkConnectStatus() {
    //handler.check_mouse_time(); // trigger connection status updater

    self.timer(1s, function() {
        if (popupMenuOpen()) {
            handler.check_mouse_time();
            checkConnectStatus();
            return;
        }
        var tmp = !!handler.get_option("stop-service");

        if (tmp != service_stopped) {
            service_stopped = tmp;
            app.update();
        }
        tmp = handler.get_connect_status();
		if (tmp[0] != connect_status) {
            connect_status = tmp[0];
            if (app.connect_status) app.connect_status.update();
        }
        if (tmp[1] != key_confirmed) {
            key_confirmed = tmp[1];
            app.update();
        }
        if (tmp[2] && tmp[2] != my_id) {
            app.update();
        }
        tmp = shownDeviceName();
        if (tmp != dashboard_device_name) {
            dashboard_device_name = tmp;
            app.update();
        }
        tmp = handler.get_error();
        if (system_error != tmp) {
            system_error = tmp;
            app.update();
        }
        if (handler.recent_sessions_updated()) {
            stdout.println("recent sessions updated");
            updateAbPeer();
            app.update();
        }
		handler.check_mouse_time();
        checkConnectStatus();
    });
}

function isRemoteControlled() {
    if (handler.get_option('allow-remote-config-modification') == 'Y') return false;
    var d = getTime() - handler.get_mouse_time();
    return d < 120;
}

checkConnectStatus();

function set_local_user_info(user) {
    var user_info = {name: user.name};
    if (user.status) {
        user_info.status = user.status;
    }
    handler.set_local_option("user_info", JSON.stringify(user_info));
}


